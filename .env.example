APP_CONFIG=config.yaml
HARDWARE_MODE=mock
TURBOPI_VENDOR_PATH=vendor/TurboPi
TURBOPI_SERIAL_DEVICE=/dev/ttyAMA0
PAN_TILT_HARDWARE_ENABLED=false
PAN_TILT_CALIBRATION_VALIDATED=false
PAN_TILT_CONTROL_ENABLED=true
PAN_TILT_CONTROL_MODE=plan_only
CAMERA_MODE=mock
IMX500_MODEL_PATH=/usr/share/imx500-models/imx500_network_ssd_mobilenetv2_fpnlite_320x320_pp.rpk
TRACKING_ENABLED=true
AUDIO_ENABLED=true
AUDIO_MODE=mock
ACTIVE_SPEAKER_ENABLED=true
ACTIVE_SPEAKER_GEOMETRY_CALIBRATED=false
CONFERENCE_ENABLED=true
CONFERENCE_MODE=mock
CONFERENCE_PUBLISH_AUDIO=false
CONFERENCE_AUDIO_INPUT_DEVICE=default
CONFERENCE_AUDIO_INPUT_VALIDATED=false
CONFERENCE_REMOTE_AUDIO_PLAYBACK=false
CONFERENCE_AUDIO_OUTPUT_DEVICE=default
CONFERENCE_AUDIO_OUTPUT_VALIDATED=false
CONFERENCE_ECHO_MANAGEMENT_MODE=monitor
CONFERENCE_ECHO_REFERENCE_VALIDATED=false
CONFERENCE_AUTH_REQUIRED=false
CONFERENCE_ACCESS_TOKEN=
WEBRTC_ICE_SERVERS=
WEBRTC_ICE_USERNAME=
WEBRTC_ICE_CREDENTIAL=
