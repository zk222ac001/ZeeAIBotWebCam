# Optional systemd environment overrides for ZeeAIBotWebCam.
#
# Installed as /etc/zee-robot/zee-robot.env with root-only permissions.
# Leave values blank unless the deployment requires them.
#
# Do not use this file to bypass Phase 13/14 safety gates. The Raspberry Pi
# hardware profile remains defined by config.pi.yaml and scripts/run_pi.sh.

# Recommended when exposing the conference UI beyond a trusted lab/LAN:
# CONFERENCE_AUTH_REQUIRED=true
# CONFERENCE_ACCESS_TOKEN=replace-with-a-long-random-secret

# Optional STUN/TURN/SFU network configuration:
# WEBRTC_ICE_SERVERS=turn:turn.example.edu:3478
# WEBRTC_ICE_USERNAME=
# WEBRTC_ICE_CREDENTIAL=

# Production control-plane protection:
# CONTROL_AUTH_REQUIRED=true
# CONTROL_ACCESS_TOKEN=replace-with-a-long-random-secret

# Set only after completing the Phase 16 production-readiness gates:
# APPLICATION_ENVIRONMENT=production
